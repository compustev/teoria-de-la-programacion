        <mxCell id="ap1bSeNCyThbIznBaXmR-4" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="&lt;div&gt;Escribir &quot;--- EVALUACION DE CREDITO HIPOTECARIO ---&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;Estado del Credito: &quot; + estado_credito ;&lt;/div&gt;&lt;div&gt;Escribir &quot;Monto del credito solicitado: &quot; + monto_credito ;&lt;/div&gt;&lt;div&gt;Escribir &quot;Monto del credito con 5% de descuento promocional: &quot; + monto_final ;&lt;/div&gt;&lt;div&gt;Escribir &quot;Cuota mensual estimada: &quot; + cuota_mensual ;&lt;/div&gt;&lt;div&gt;Escribir &quot;Ratio de endeudamiento: &quot; + ratio_endeudamiento ;&lt;/div&gt;&lt;div&gt;Escribir &quot;Compromisos financieros actuales:&quot; + compromisos ;&lt;/div&gt;" vertex="1">
