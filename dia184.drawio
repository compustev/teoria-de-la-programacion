        </mxCell>
        <mxCell id="ap1bSeNCyThbIznBaXmR-30" edge="1" parent="1" source="ap1bSeNCyThbIznBaXmR-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;" target="ap1bSeNCyThbIznBaXmR-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap1bSeNCyThbIznBaXmR-5" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="&lt;div&gt;Escribir &quot;--------------------------------------------------&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CONCLUSIONES&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;--------------------------------------------------&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;1. La viabilidad del credito depende estrictamente de que el ratio&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;&amp;nbsp; &amp;nbsp;de endeudamiento total no supere el limite maximo del 40%.&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;2. Un enganche adecuado (mayor o igual al 20%) reduce significativamente&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;&amp;nbsp; &amp;nbsp;el riesgo financiero y la cuota mensual a pagar.&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;3. El cumplimiento de los ingresos minimos garantiza la capacidad&quot; ;&lt;/div&gt;&lt;div&gt;Escribir &quot;&amp;nbsp; &amp;nbsp;de pago a largo plazo frente a otros compromisos de deuda.&quot; ;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="715" x="56" y="962.5" as="geometry" />
        </mxCell>
        <mxCell id="ap1bSeNCyThbIznBaXmR-12" edge="1" parent="1" source="ap1bSeNCyThbIznBaXmR-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;" target="ap1bSeNCyThbIznBaXmR-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap1bSeNCyThbIznBaXmR-6" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="&lt;div&gt;Leer ingreso_mensual ;&lt;/div&gt;&lt;div&gt;Leer val_inmueble ;&lt;/div&gt;&lt;div&gt;Leer enganche ;&lt;/div&gt;&lt;div&gt;Leer plazo ;&lt;/div&gt;&lt;div&gt;Leer interes ;&lt;/div&gt;&lt;div&gt;Leer compromisos ;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="315" y="190" as="geometry" />
        </mxCell>
        <mxCell id="ap1bSeNCyThbIznBaXmR-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="estado_credito = &quot;APROBADO&quot; ;" vertex="1">
          <mxGeometry height="60" width="120" x="90" y="563" as="geometry" />
        </mxCell>
        <mxCell id="ap1bSeNCyThbIznBaXmR-18" edge="1" parent="1" source="ap1bSeNCyThbIznBaXmR-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;" target="ap1bSeNCyThbIznBaXmR-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap1bSeNCyThbIznBaXmR-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;monto_credito = val_inmueble - enganche ;&lt;/div&gt;&lt;div&gt;meses_totales = plazo * MESES_YEAR ;&lt;/div&gt;&lt;div&gt;tasa_mensual = (interes / 100) / MESES_YEAR ;&lt;/div&gt;&lt;div&gt;cuota_mensual = (monto_credito * tasa_mensual) / (1 - (1 + tasa_mensual) ^ (-meses_totales)) ;&lt;/div&gt;&lt;div&gt;ratio_endeudamiento = (cuota_mensual + compromisos) / ingreso_mensual ;&lt;/div&gt;&lt;div&gt;monto_final = monto_credito * 0.95 ;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="550" x="125" y="305" as="geometry" />
        </mxCell>
